#!/usr/bin/env python3
"""Run the board controller CLI straight from a repo checkout (no install needed, stdlib only).

`bin/bsp` is the same program under its old name: this one is the name to use.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from bsp.cli.main import cli  # noqa: E402

sys.exit(cli())
