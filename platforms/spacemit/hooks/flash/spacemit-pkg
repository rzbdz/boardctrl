#!/usr/bin/env python3
"""flash/spacemit-pkg: flash a SpacemiT pack_image package over fastboot (vendor order).

The package is a zip (`artifacts.flash-zip`, from a boot recipe) or an unpacked directory
(`package_dir`, from `bsp dut flash`). The board must run a U-Boot that answers fastboot: a boot
recipe stages it first; with `package_dir`, a board still in the boot ROM's download mode is brought
up by the package's own fastboot.yaml `stage`/`continue` actions before the first flash.
request : {"usb": "usb:2-1.2", "fastboot": "fastboot",
           "artifacts": {"flash-zip": "/path/spacemit_k3_flash_image_*.zip"}  (or "package_dir": "/dir"),
           "args": {"media": ["mtd", "gpt"], "skip": ["rootfs"], "dry_run": false,
                    "rom_product": "DFU download", "port_timeout": 30}}
result  : {"flashed": [{"layout": "partition_4M.json", "partition": "fsbl", "image": "...", "s": 1.2}, ...],
           "layouts": [...], "seconds": 93.1}
Layout files follow fastboot.yaml `multi_flash`: partition_<getvar mtd-size>.json for NOR (format mtd)
and partition_<getvar blk-size>.json for block media (format gpt); a layout is written first
(`fastboot flash mtd|gpt <json>`), then every partition that has an image in the package.

bsp-hook: check plan only
With `"check": true` it only says whether it can run here (fastboot found), touching nothing:
{"ready": true} or {"ready": false, "reason", "hint"}.
With `"plan": true` it reads the unpacked package (`package_dir`) and says what flashing it would write, touching
nothing: {"plan": {"package", "media": [{"id", "label", "size", "partitions": [{"name", "offset", "size",
"image", "payload", "selectable"}]}], "partial": true, "notes": [...]}} (bytes; null where the layout leaves it
open). Every layout in the package is listed: which one is written is chosen from the sizes the board reports.
`args.only` (partition names) flashes only those partitions, on each medium whose layout has one; a medium with
none of them is left alone. A name no layout has is refused with the names there are. `args.layout` (a layout's
file name) writes that layout's medium alone: a preset says both, so picking "NOR boot" for a board whose medium is
a disk is refused here, with what the board has.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile


def fb(binary, usb, *args, timeout=900):
    r = subprocess.run([binary, "-s", usb, *args], capture_output=True, text=True, timeout=timeout)
    out = (r.stdout + r.stderr).strip()
    return r.returncode, out


def getvar(binary, usb, name):
    rc, out = fb(binary, usb, "getvar", name, timeout=15)
    m = re.search(rf"^{re.escape(name)}:\s*(\S+)", out, re.M)
    return m.group(1) if m and rc == 0 else None


def port_line(binary, usb):
    """The `fastboot devices -l` line of the device on `usb` (None when it is not on the bus)."""
    try:
        r = subprocess.run([binary, "devices", "-l"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in (r.stdout + r.stderr).splitlines():
        if re.search(rf"(?<!\S){re.escape(usb)}(?!\S)", line):
            return line
    return None


def wait_port(binary, usb, timeout):
    """Wait for the device to leave the bus (a continue hands over) and come back; its line, or None."""
    t_end, gone = time.monotonic() + timeout, False
    while time.monotonic() < t_end:
        line = port_line(binary, usb)
        if line is None:
            gone = True
        elif gone or time.monotonic() > t_end - timeout + 5:
            return line
        time.sleep(0.5)
    return None


def bring_up(work, binary, usb, args):
    """A board in the boot ROM's download mode: run the package's fastboot.yaml stage/continue actions that come
    before its first flash, so a U-Boot that answers fastboot runs. Returns None, or an error result."""
    rom = args.get("rom_product", "DFU download")
    line = port_line(binary, usb)
    if not line or rom not in line:
        return None
    path = os.path.join(work, "fastboot.yaml")
    if not os.path.exists(path):
        return {"error": f"the board is in the boot ROM's download mode and the package has no fastboot.yaml",
                "hint": "bring U-Boot up first (a recipe stage step), or flash a package with fastboot.yaml"}
    try:
        import yaml
    except ImportError:
        return {"error": "PyYAML is not installed on this host", "hint": "pip install pyyaml (or apt install python3-yaml)"}
    actions = (yaml.safe_load(open(path)) or {}).get("actions") or []
    print(f"{usb} is in boot ROM download mode: bringing U-Boot up with fastboot.yaml")
    for act in actions:
        (kind, data), = act.items() if isinstance(act, dict) and len(act) == 1 else [(None, None)]
        if kind in ("flash", "multi_flash"):
            break
        if kind == "stage":
            f = os.path.join(work, (data or {}).get("file", ""))
            if not os.path.isfile(f):
                return {"error": f"fastboot.yaml stages {(data or {}).get('file')!r}, which the package lacks"}
            rc, out = fb(binary, usb, "stage", f, timeout=float((data or {}).get("timeout") or 300))
            print(f"stage {os.path.basename(f)}: {out.splitlines()[-1] if out else rc}")
            if rc != 0 or "FAILED" in out:
                return {"error": f"staging {os.path.basename(f)} failed: {out[-200:]}"}
        elif kind == "continue":
            rc, out = fb(binary, usb, "continue", timeout=30)
            if rc != 0 or "FAILED" in out:
                return {"error": f"fastboot continue failed: {out[-200:]}"}
            line = wait_port(binary, usb, float(args.get("port_timeout", 30)))
            if not line:
                return {"error": f"the download port did not come back on {usb} after continue",
                        "hint": "check the console: did the staged loader start?"}
            print(f"continued; port back: {' '.join(line.split())}")
    return None


def check(req):
    binary = req.get("fastboot") or "fastboot"
    if not (shutil.which(binary) or (os.path.isfile(binary) and os.access(binary, os.X_OK))):
        print(json.dumps({"ready": False, "reason": f"no {binary} on this host",
                          "hint": "apt install fastboot (or android-sdk-platform-tools)"}))
        return 2
    print(json.dumps({"ready": True}))
    return 0


UNITS = {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}


def nbytes(v):
    """A layout's offset or size ("640K", "4M", "0", 1024) in bytes; None for "-" (the rest) or none given."""
    if v is None or v == "-" or v == "":
        return None
    if isinstance(v, int):
        return v
    m = re.fullmatch(r"\s*(\d+)\s*([KMGT]?)i?B?\s*", str(v), re.I)
    return int(m.group(1)) * UNITS[m.group(2).upper()] if m else None


def layouts_in(work):
    """The package's partition layouts that name a medium format: (file name, table)."""
    out = []
    for name in sorted(os.listdir(work)):
        if name.startswith("partition_") and name.endswith(".json"):
            try:
                table = json.load(open(os.path.join(work, name)))
            except (OSError, ValueError):
                continue
            if isinstance(table, dict) and table.get("format") in ("mtd", "gpt"):
                out.append((name, table))
    return out


def image_of(work, p):
    """The file a partition is written from, as flash() picks it: its image, or the last of a list that is here."""
    image = p.get("image")
    names = [image] if isinstance(image, str) else [str(x) for x in image or []]
    return next((n for n in reversed(names) if os.path.exists(os.path.join(work, n))), None)


def plan(req):
    """What flashing the package would write, read from its layouts: nothing is touched."""
    work = req.get("package_dir")
    if not work or not os.path.isdir(work):
        print(json.dumps({"error": "plan needs package_dir, the unpacked package"}))
        return 1
    media = []
    for name, table in layouts_in(work):
        fmt = table["format"]
        parts, at = [], 0
        for p in table.get("partitions") or []:
            size, given = nbytes(p.get("size")), nbytes(p.get("offset"))
            offset = given if given is not None else at
            chosen = image_of(work, p)
            parts.append({"name": str(p.get("name")), "offset": offset, "size": size,
                          "image": chosen, "payload": os.path.getsize(os.path.join(work, chosen)) if chosen else None,
                          "selectable": bool(chosen)})
            at = offset + size if offset is not None and size is not None else None
        sized = name[len("partition_"):-len(".json")]
        medium = nbytes(sized) if re.fullmatch(r"\d+[KMGT]", sized) else None
        label = ("NOR" if fmt == "mtd" else "block") + f" ({fmt}) · {name}"
        media.append({"id": name, "label": label, "size": medium, "kind": "nor" if fmt == "mtd" else "emmc", "partitions": parts})
    notes = []
    kinds = [medium_kind(m) for m in media]
    if any(kinds.count(kind) > 1 for kind in kinds):
        notes.append("the package carries several layouts: the one written to each medium is chosen from the size "
                     "the board reports for it (getvar mtd-size / blk-size) when it is flashed")
    notes.append("with chosen partitions, each medium holding one has its layout written again first; the other "
                 "media are left alone")
    print(json.dumps({"plan": {"package": os.path.basename(os.path.normpath(work)), "media": media,
                               "partial": True, "presets": presets_of(media), "notes": notes}}))
    return 0


def medium_kind(medium):
    """Which medium a layout is for: the NOR flash (`mtd`), or a block device (`gpt`)."""
    return "NOR" if "(mtd)" in medium["label"] else "block"


def presets_of(media):
    """The selections worth offering by name, one per medium: a board boots from its NOR flash or from its eMMC/SD,
    and the package carries a layout for each. Picking one is picking both the medium and those partitions, instead
    of reading every layout's names.

    Each preset says the layout it writes, so a board whose medium is not the one picked is told so rather than given
    a partition list that belongs to another medium. A package with a single medium has nothing to choose between."""
    kinds = {medium_kind(m) for m in media}
    if len(kinds) < 2:
        return []
    presets = []
    for kind in ("NOR", "block"):
        chosen = [m for m in media if medium_kind(m) == kind]
        if not chosen:
            continue
        names = []
        for m in chosen:
            names.extend(p["name"] for p in m["partitions"] if p["selectable"] and p["name"] not in names)
        label = "NOR 启动" if kind == "NOR" else "eMMC/SD"
        about = (f"只刷 NOR 上那套（{', '.join(m['id'] for m in chosen)}）" if kind == "NOR"
                 else f"只刷块设备上那套（{', '.join(m['id'] for m in chosen)}）")
        presets.append({"id": "nor" if kind == "NOR" else "block", "label": label, "about": about,
                        "layout": chosen[0]["id"], "partitions": names})
    return presets


def main():
    req = json.loads(sys.stdin.read())
    if req.get("check"):
        return check(req)
    if req.get("plan"):
        return plan(req)
    usb, binary = req["usb"], req.get("fastboot", "fastboot")
    args = req.get("args") or {}
    media = args.get("media", ["mtd", "gpt"])
    skip = set(args.get("skip", []))
    only = [str(x) for x in args.get("only") or []]
    t0 = time.monotonic()
    pkg_dir = req.get("package_dir")
    if pkg_dir:
        if not os.path.isdir(pkg_dir):
            print(json.dumps({"error": f"package_dir {pkg_dir} is not a directory"}))
            return 1
        work, pkg = pkg_dir, pkg_dir
        print(f"package {os.path.basename(pkg)} ({len(os.listdir(work))} entries)")
        failed = bring_up(work, binary, usb, args)
        if failed:
            print(json.dumps(failed))
            return 1
    else:
        pkg = (req.get("artifacts") or {}).get("flash-zip")
        if not pkg or not os.path.exists(pkg):
            print(json.dumps({"error": "no flash-zip artifact", "hint": "build it: bsp sdk build <sdk> pack-image"}))
            return 1
        work = tempfile.mkdtemp(prefix="bsp-flash-")
        with zipfile.ZipFile(pkg) as z:
            z.extractall(work)
        print(f"unpacked {os.path.basename(pkg)} ({len(os.listdir(work))} entries)")
    try:
        if only:
            # Before the board is touched: a name no layout has is a mistake, said with the names there are.
            known = sorted({str(p.get("name")) for _, t in layouts_in(work) for p in t.get("partitions") or []
                            if image_of(work, p)})
            unknown = [n for n in only if n not in known]
            if unknown:
                print(json.dumps({"error": f"no partition {', '.join(unknown)} in this package",
                                  "hint": f"partitions with an image here: {', '.join(known) or '(none)'}"}))
                return 1
        return flash(req, work, pkg, binary, usb, args, media, skip, t0, set(only))
    finally:
        if work != pkg_dir:
            shutil.rmtree(work, ignore_errors=True)


def flash(req, work, pkg, binary, usb, args, media, skip, t0, only=frozenset()):

    sizes = {"mtd": getvar(binary, usb, "mtd-size"), "gpt": getvar(binary, usb, "blk-size")}
    print(f"device reports mtd-size={sizes['mtd']} blk-size={sizes['gpt']}")
    # U-Boot answers NULL for a medium the board does not have (e.g. no SPI NOR on a UFS board): skip that
    # medium. No answer at all (an older U-Boot) still falls back to the package's layouts.
    absent = {fmt for fmt, v in sizes.items() if v is not None and v.upper() in ("NULL", "NONE")}
    def mib(v):
        m = re.fullmatch(r"(\d+)([KMG])", v or "")
        return int(m.group(1)) * {"K": 1 / 1024, "M": 1, "G": 1024}[m.group(2)] if m else None

    # A preset names the layout it writes: that medium alone, and only if the board has it. Choosing "NOR boot" on a
    # board with no NOR (or a board whose NOR is another size than the package's layout) is a mistake said here,
    # before any of it is written.
    wanted = args.get("layout")
    layouts = []
    if wanted:
        if not os.path.exists(os.path.join(work, str(wanted))):
            print(json.dumps({"error": f"no layout {wanted} in this package",
                              "hint": f"layouts here: {', '.join(sorted(n for n in os.listdir(work) if n.startswith('partition_')))}"}))
            return 1
        fmt = json.load(open(os.path.join(work, str(wanted)))).get("format")
        if fmt not in media:
            print(json.dumps({"error": f"layout {wanted} is for {fmt}, which this flash does not write"}))
            return 1
        if fmt in absent:
            print(json.dumps({"error": f"the board has no {'NOR' if fmt == 'mtd' else 'block'} medium ({'mtd' if fmt == 'mtd' else 'blk'}-size={sizes[fmt]}), so {wanted} cannot be written",
                              "hint": "pick the other layout, or leave the choice to the board"}))
            return 1
        layouts = [(fmt, str(wanted))]
        print(f"writing {wanted} only ({fmt})")
    else:
        for fmt in media:
            if fmt in absent:
                print(f"device has no {fmt} medium ({'mtd' if fmt == 'mtd' else 'blk'}-size={sizes[fmt]}); skipping {fmt}")
                continue
            cand = []
            if sizes.get(fmt):
                cand.append(f"partition_{sizes[fmt]}.json")
            sized = []
            for name in sorted(os.listdir(work)):
                if name.startswith("partition_") and name.endswith(".json"):
                    size = mib(name[len("partition_"):-len(".json")])
                    sized.append((size, name))
            dev = mib(sizes.get(fmt))
            # exact match first; else the largest sized layout that fits the device; then the rest
            fits = sorted((s, n) for s, n in sized if s is not None and (dev is None or s <= dev))
            cand += [n for _, n in reversed(fits)] + [n for s, n in sized if s is None]
            if dev and f"partition_{sizes[fmt]}.json" not in os.listdir(work) and fits:
                print(f"no partition_{sizes[fmt]}.json in package; using {fits[-1][1]} (largest layout <= {sizes[fmt]})")
            for name in cand:
                p = os.path.join(work, name)
                if os.path.exists(p) and json.load(open(p)).get("format") == fmt:
                    layouts.append((fmt, name))
                    break
            else:
                print(f"no {fmt} layout in package or device has no {fmt} medium; skipping {fmt}")
    if not layouts:
        print(json.dumps({"error": "no usable partition layout", "hint": "is U-Boot (not SPL) answering fastboot?"}))
        return 1

    flashed, failed, skipped = [], [], []
    plans = []
    for fmt, name in layouts:
        table = json.load(open(os.path.join(work, name)))
        parts = []
        for p in table["partitions"]:
            # A partition's `image` is a file name, or a list of them where a builder composed a filesystem
            # (image_build.py lists bootfs.vfat's inputs, the composed file last): what gets flashed is the
            # composed file, so the list is read from its end.
            image = p.get("image")
            names = [image] if isinstance(image, str) else [str(x) for x in image or []]
            chosen = next((n for n in reversed(names) if os.path.exists(os.path.join(work, n))), None)
            if only and p["name"] not in only:
                continue
            if chosen:
                parts.append((p["name"], os.path.join(work, chosen)))
            elif names and p["name"] not in skip:
                skipped.append((name, p["name"], names))
        if only and not parts:
            print(f"{name}: none of {', '.join(sorted(only))} is on this medium; leaving it alone")
            continue
        plans.append((name, [(fmt, os.path.join(work, name))] + [x for x in parts if x[1]]))
    for name, part, names in skipped:
        print(f"skip {part}: none of {', '.join(names)} is in the package ({name})")
    total = sum(os.path.getsize(i) for _, plan in plans for _, i in plan if os.path.exists(i)) or 1
    done = 0
    for name, plan in plans:
        for part, image in plan:
            if not os.path.exists(image):
                print(f"skip {part}: {os.path.relpath(image, work)} not in package")
                continue
            if args.get("dry_run"):
                print(f"[dry-run] fastboot flash {part} {os.path.relpath(image, work)}")
                continue
            ts = time.monotonic()
            rc, out = fb(binary, usb, "flash", part, image)
            secs = round(time.monotonic() - ts, 1)
            rel = os.path.relpath(image, work)
            if rc != 0 or "FAILED" in out:
                print(f"FAILED {name}: flash {part} {rel}: {out[-200:]}")
                failed.append({"layout": name, "partition": part, "error": out[-300:]})
                break
            print(f"{name}: flash {part} <- {rel} ({os.path.getsize(image):,} B) {secs}s")
            flashed.append({"layout": name, "partition": part, "image": rel, "s": secs})
            done += os.path.getsize(image)
            print(json.dumps({"progress": round(done * 100 / total, 1), "msg": f"{part} done"}), flush=True)
    result = {"flashed": flashed, "failed": failed, "layouts": [n for _, n in layouts],
              "seconds": round(time.monotonic() - t0, 1), "package": os.path.basename(pkg)}
    if failed:
        result["error"] = f"flashing {failed[0]['partition']} failed"
        result["hint"] = "check the console log; the staged U-Boot must support this medium"
        print(json.dumps(result))
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
